{
  "name": "@owntube/youtube",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OwnTube's InnerTube layer (youtubei.js): egress, sessions, PO tokens, player and browse, mapped to OwnTube's domain model. Also holds the recorded YouTube fixture corpus.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "record:corpus": "node scripts/record-corpus.ts",
    "probe:clients": "node scripts/probe-clients.ts",
    "probe:sustained": "node scripts/probe-sustained.ts",
    "probe:potoken": "node scripts/probe-potoken.ts"
  },
  "dependencies": {
    "@owntube/playback": "workspace:*",
    "bgutils-js": "^4.0.3",
    "googlevideo": "^5.0.1",
    "playwright-core": "1.59.1",
    "undici": "^7.30.0",
    "youtubei.js": "^18.3.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5",
    "vitest": "^4.0.3"
  },
  "exports": {
    "./clients": "./src/clients.ts",
    "./egress": "./src/egress.ts",
    "./player": "./src/player.ts",
    "./playability": "./src/playability.ts",
    "./presentation": "./src/presentation.ts",
    "./session": "./src/session.ts",
    "./youtube": "./src/youtube.ts",
    "./sabr": "./src/sabr.ts",
    "./potoken": "./src/potoken.ts"
  }
}
