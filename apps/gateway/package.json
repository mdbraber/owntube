{
  "name": "gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OwnTube's YouTube gateway: the only process that talks to YouTube (metadata, playback sessions, manifests, media, captions, images).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@owntube/playback": "workspace:*",
    "@owntube/youtube": "workspace:*",
    "cacache": "^20.0.0",
    "hono": "^4.13.22",
    "zod": "^4.1.12",
    "@owntube/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/cacache": "^20.0.0",
    "@types/node": "^24",
    "typescript": "^5",
    "vitest": "^4.0.3"
  }
}
