# Copy to .env.unraid on your Unraid host.

# Use long random values:
# openssl rand -base64 48
AUTH_SECRET=replace-with-long-random-secret
# Shared by the web app and the gateway (API key and playback URL signatures).
GATEWAY_SIGNING_KEY=replace-with-another-long-random-secret

# Auth.js host trust + canonical URL (required)
AUTH_TRUST_HOST=true
AUTH_URL=http://192.168.1.11:3000

# Only variables listed in docker-compose.unraid.yml are passed to the containers.
# The app and gateway refuse to start while either secret above is a placeholder.

# YouTube flags IPv6 /64s faster than single IPv4 addresses.
# GATEWAY_EGRESS_FAMILY=ipv4
# GATEWAY_TRANSPORT=auto
# GATEWAY_PROXY_URL=http://proxy:3128
# GATEWAY_IMAGE_CACHE_MAX_BYTES=1073741824

# Cache warmer (inside the app; 0 turns it off). See docs/SELF-HOSTING.md for all settings.
# OWNTUBE_WARM_INTERVAL_SEC=900
# OWNTUBE_WARM_REGION=US

# Logging
LOG_LEVEL=info

# Optional timezone shown in logs
TZ=Europe/Paris
