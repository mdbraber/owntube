# SQLite file (default: ./data/owntube.db)
DATABASE_PATH=./data/owntube.db

# The YouTube gateway (apps/gateway): its internal address, and the key it
# shares with the web app (API bearer token and playback URL signatures).
# Generate one with: openssl rand -base64 48 (the placeholder works for
# development; a production app or gateway refuses to start with it).
GATEWAY_URL=http://localhost:8080
GATEWAY_SIGNING_KEY=change-me-to-a-long-random-value
# How long a signed playback URL stays valid (seconds; default 6h).
# GATEWAY_PLAYBACK_TTL_SEC=21600

# debug | info | warn | error
LOG_LEVEL=info

# Recommendation score debug: logs to stdout and logs/recommendation-debug.ndjson
# OWNTUBE_DEBUG_RECOMMENDATIONS=1
# Optional absolute or cwd-relative path:
# OWNTUBE_RECOMMENDATION_LOG_PATH=./logs/my-recs.ndjson

# Next.js (disable telemetry in containers)
NEXT_TELEMETRY_DISABLED=1

# Auth.js secret for JWT sessions. Generate one with: openssl rand -base64 48
# The placeholder works for development; a production server refuses to start with it.
AUTH_SECRET=change-me-in-production

# ── Cache warmer (runs inside the web app; 0 turns it off) ────────────────────
# OWNTUBE_WARM_INTERVAL_SEC=900
# OWNTUBE_WARM_REGION=US
# OWNTUBE_WARM_LIMIT=48
# OWNTUBE_WARM_CHANNELS=true
# OWNTUBE_WARM_CHANNEL_PAGES=true
# OWNTUBE_WARM_SHORTS=true
# OWNTUBE_WARM_RECENCY=true
# OWNTUBE_WARM_RSS=true
# OWNTUBE_WARM_VIDEOS=true
# OWNTUBE_WARM_VIDEO_LIMIT=5
# OWNTUBE_WARM_HOME=true
# OWNTUBE_WARM_HISTORY_CHANNELS=32
# OWNTUBE_WARM_SUBSCRIPTION_CHANNELS=64

# ── Gateway (read by apps/gateway; `pnpm dev:gateway` loads this file too) ────
# YouTube flags whole IPv6 /64s faster than single IPv4 addresses.
# GATEWAY_EGRESS_FAMILY=ipv4
# GATEWAY_TRANSPORT=auto            # sabr: skip byte ranges when YouTube refuses them
# GATEWAY_PROXY_URL=http://proxy:3128
# GATEWAY_CACHE_DIR=data/cache
# GATEWAY_IMAGE_CACHE_MAX_BYTES=1073741824
# GATEWAY_PO_BROWSER=/usr/bin/chromium
