{
  "name": "tv",
  "version": "0.5.0",
  "private": true,
  "packageManager": "pnpm@11.29.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "EXPO_TV=1 expo run:android",
    "prebuild": "EXPO_TV=1 expo prebuild --platform android --clean",
    "typecheck": "tsc --noEmit",
    "prebuild:tvos": "EXPO_TV=1 REACT_NATIVE_NODE_MODULES_DIR=$PWD/node_modules expo prebuild --platform ios --clean",
    "tvos": "EXPO_TV=1 REACT_NATIVE_NODE_MODULES_DIR=$PWD/node_modules expo run:ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-tvos/config-tv": "^0.1.7",
    "@tanstack/query-async-storage-persister": "^5.90.5",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-query-persist-client": "^5.90.5",
    "@trpc/client": "^11.7.1",
    "@trpc/react-query": "^11.7.1",
    "@trpc/server": "^11.7.1",
    "expo": "~58.0.26",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-file-system": "~58.0.14",
    "expo-keep-awake": "~58.0.4",
    "expo-secure-store": "~58.0.3",
    "expo-speech-recognition": "^58.0.1",
    "expo-status-bar": "~58.0.5",
    "expo-video": "~58.0.14",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-native": "npm:react-native-tvos@0.88.1-0",
    "react-native-svg": "15.16.0",
    "superjson": "^2.2.5"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.3.0",
    "typescript": "~5.9.0"
  },
  "expo": {
    "autolinking": {
      "ios": {
        "exclude": [
          "expo-speech-recognition"
        ]
      }
    }
  }
}
