{
  "expo": {
    "name": "OwnTube",
    "slug": "owntube-tv",
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "platforms": ["android", "ios"],
    "android": {
      "package": "com.mdbraber.owntube.tv",
      "icon": "./assets/icon.png",
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "https",
              "host": "www.youtube.com"
            },
            {
              "scheme": "https",
              "host": "youtube.com"
            },
            {
              "scheme": "https",
              "host": "m.youtube.com"
            },
            {
              "scheme": "https",
              "host": "music.youtube.com"
            },
            {
              "scheme": "https",
              "host": "youtu.be"
            },
            {
              "scheme": "http",
              "host": "www.youtube.com"
            },
            {
              "scheme": "http",
              "host": "youtube.com"
            },
            {
              "scheme": "http",
              "host": "youtu.be"
            }
          ]
        }
      ]
    },
    "plugins": [
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": true,
          "androidTVBanner": "./assets/banner.png",
          "appleTVImages": {
            "iconLayers": {
              "front": "./assets/appletv/icon-front.png",
              "back": "./assets/appletv/icon-back.png"
            },
            "iconSmallLayers": {
              "front": "./assets/appletv/icon-small-front.png",
              "back": "./assets/appletv/icon-small-back.png"
            },
            "iconSmall2xLayers": {
              "front": "./assets/appletv/icon-small@2x-front.png",
              "back": "./assets/appletv/icon-small@2x-back.png"
            },
            "topShelf": "./assets/appletv/top-shelf.png",
            "topShelf2x": "./assets/appletv/top-shelf@2x.png",
            "topShelfWide": "./assets/appletv/top-shelf-wide.png",
            "topShelfWide2x": "./assets/appletv/top-shelf-wide@2x.png"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "buildArchs": ["armeabi-v7a", "arm64-v8a"]
          }
        }
      ],
      "expo-speech-recognition",
      "./plugins/with-tv-search",
      "./plugins/with-media-keys",
      "./plugins/with-release-signing",
      "./plugins/with-image-memory",
      "./plugins/with-top-shelf"
    ],
    "extra": {
      "owntubeUrl": "http://10.0.2.2:3000"
    },
    "icon": "./assets/icon.png",
    "scheme": "owntube",
    "ios": {
      "bundleIdentifier": "com.mdbraber.owntube.tv"
    }
  }
}
