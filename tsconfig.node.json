{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "Shared base for the Node packages and apps (gateway, youtube, ...). They run as TypeScript directly on Node's type stripping, so only erasable syntax is allowed and relative imports carry their .ts extension.",
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  }
}
